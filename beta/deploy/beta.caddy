redir /beta /beta/ 308
handle_path /beta/* {
    root * /srv/sb-live-lapse-beta/current
    header Cache-Control "no-store"
    @beta_html path / /index.html
    header @beta_html Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'self' blob:; connect-src 'self'; upgrade-insecure-requests"
    file_server
}
